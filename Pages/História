 <script>
    // ESPERA DOM CARREGAR
    document.addEventListener('DOMContentLoaded', function() {
        // JS Modais
        document.querySelectorAll('.card').forEach(card => {
            card.addEventListener('click', (e) => {
                const modalId = card.dataset.modal;
                const modal = document.getElementById(`modal-${modalId}`);
                if (modal) {
                    modal.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                }
            });
        });

        // JS Carrossel Heróis (se existir)
        if (document.querySelector('#carousel-track')) {
            let currentHeroSlide = 0;
            const heroSlides = document.querySelectorAll('#carousel-track .carousel-slide');
            const heroDots = document.querySelectorAll('.carousel-dots .dot');

            function showHeroSlide(index) {
                heroSlides.forEach(slide => slide.classList.remove('active'));
                heroDots.forEach(dot => dot.classList.remove('active'));
                heroSlides[index].classList.add('active');
                heroDots[index].classList.add('active');
                currentHeroSlide = index;
            }

            window.changeSlide = function(direction) {
                currentHeroSlide = (currentHeroSlide + direction + heroSlides.length) % heroSlides.length;
                showHeroSlide(currentHeroSlide);
            };

            window.currentSlide = function(index) {
                showHeroSlide(index - 1);
            };

            // Autoplay
            let heroAutoSlide = setInterval(() => changeSlide(1), 5000);
            document.querySelector('.carousel-container')?.addEventListener('mouseenter', () => clearInterval(heroAutoSlide));
            document.querySelector('.carousel-container')?.addEventListener('mouseleave', () => {
                heroAutoSlide = setInterval(() => changeSlide(1), 5000);
            });
            showHeroSlide(0);
        }
    });

    // Função closeModal global
    window.closeModal = function(modalId) {
        const modal = document.getElementById(`modal-${modalId}`);
        if (modal) {
            modal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }
    };

    // Fechar clicando fora
    document.addEventListener('click', (e) => {
        if (e.target.classList.contains('modal-overlay')) {
            const modalId = e.target.id.split('-')[1];
            closeModal(modalId);
        }
    });

    // Scroll suave
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            document.querySelector(this.getAttribute('href'))?.scrollIntoView({ behavior: 'smooth' });
        });
    });
</script>
</body>
</html>
