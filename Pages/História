<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>História - Gatundo</title>
    <style>
        :root {
            --bg-primary: #232F40;
            --accent-gold: #F2AA52;
            --accent-orange: #F27F3D;
            --accent-red1: #F25430;
            --accent-red2: #F23E2E;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Arial Black', Arial, sans-serif; 
            background: linear-gradient(135deg, var(--bg-primary) 0%, #1a2530 50%, #0f1925 100%); 
            color: #fff; 
            overflow-x: hidden;
        }
        .container { max-width: 1400px; margin: 0 auto; padding: 0 20px; }
        
        /* Header */
        header { 
            background: rgba(35,47,64,0.95); 
            padding: 1rem 0; 
            position: sticky; 
            top: 0; 
            z-index: 100; 
            backdrop-filter: blur(20px);
            border-bottom: 3px solid var(--accent-gold);
        }
        nav { display: flex; justify-content: space-between; align-items: center; }
        .logo { 
            font-size: 2.5rem; 
            font-weight: 900; 
            background: linear-gradient(45deg, var(--accent-gold), var(--accent-orange)); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
            text-shadow: 0 0 30px rgba(242,170,82,0.7);
        }
        .menu { display: flex; gap: 2rem; list-style: none; }
        .menu a { 
            color: #fff; 
            text-decoration: none; 
            font-weight: bold; 
            padding: 0.5rem 1rem; 
            border-radius: 25px; 
            transition: all 0.3s; 
            border: 1px solid transparent;
        }
        .menu a:hover { 
            background: var(--accent-gold); 
            color: var(--bg-primary); 
            border-color: var(--accent-gold);
            transform: scale(1.05); 
        }
        
        /* Hero História */
        .historia-hero { 
            text-align: center; 
            padding: 5rem 2rem; 
            position: relative;
            background: linear-gradient(135deg, rgba(35,47,64,0.8), rgba(15,25,37,0.8));
        }
        .historia-title { 
            font-size: 4rem; 
            margin-bottom: 2.5rem; 
            background: linear-gradient(45deg, var(--accent-gold), var(--accent-orange), var(--accent-red1)); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 50px rgba(242,170,82,0.8);
            animation: pulseGlow 2.5s ease-in-out infinite alternate;
        }
        @keyframes pulseGlow {
            from { 
                filter: drop-shadow(0 0 30px rgba(242,170,82,0.6)) brightness(1); 
            }
            to { 
                filter: drop-shadow(0 0 60px rgba(242,127,61,1)) brightness(1.1); 
            }
        }
        .historia-subtitle { 
            font-size: 1.6rem; 
            opacity: 0.95; 
            margin-bottom: 1rem;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }
        .historia-image { 
            max-width: 100%; 
            height: 450px; 
            object-fit: cover; 
            border-radius: 35px; 
            box-shadow: 0 50px 100px rgba(242,62,46,0.6); 
            margin: 3rem 0;
            border: 5px solid var(--accent-red2);
            transition: transform 0.5s;
        }
        .historia-image:hover { transform: scale(1.02); }
        
        /* Cards Gradiente Vibrante */
        .cards-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); 
            gap: 2.5rem; 
            padding: 5rem 0 10rem; 
        }
        .card { 
            background: linear-gradient(145deg, var(--accent-red1), var(--accent-red2), var(--accent-orange)); 
            border: 4px solid var(--accent-gold); 
            border-radius: 30px; 
            padding: 3rem 2.5rem; 
            text-align: center; 
            cursor: pointer; 
            transition: all 0.5s cubic-bezier(0.34,1.56,0.64,1); 
            backdrop-filter: blur(25px); 
            position: relative; 
            overflow: hidden;
            min-height: 260px;
            display: flex; 
            flex-direction: column; 
            justify-content: center;
            box-shadow: 0 25px 50px rgba(242,62,46,0.4);
        }
        .card::before { 
            content: ''; 
            position: absolute; 
            top: -50%; 
            left: -50%; 
            width: 200%; 
            height: 200%; 
            background: conic-gradient(transparent, rgba(255,255,255,0.4), transparent); 
            transition: 0.8s; 
            transform: rotate(0deg);
        }
        .card:hover::before { 
            transform: rotate(180deg); 
        }
        .card:hover { 
            transform: translateY(-25px) scale(1.08) rotateX(5deg); 
            border-color: var(--accent-gold); 
            box-shadow: 0 50px 120px rgba(242,170,82,0.7); 
        }
        .card-icon { 
            font-size: 4rem; 
            margin-bottom: 1.5rem; 
            text-shadow: 0 0 20px rgba(255,255,255,0.6);
            animation: bounce 2s infinite;
        }
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-10px); }
            60% { transform: translateY(-5px); }
        }
        .card h3 { 
            font-size: 2rem; 
            margin-bottom: 1.2rem; 
            background: linear-gradient(45deg, var(--accent-gold), #fff); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
            font-weight: 900;
            text-shadow: 0 0 15px rgba(242,170,82,0.8);
        }
        .card p { 
            opacity: 0.97; 
            line-height: 1.7; 
            margin-bottom: 2rem; 
            font-size: 1.1rem;
        }
        
        /* Modal Premium */
        .modal-overlay { 
            display: none; 
            position: fixed; 
            inset: 0; 
            background: rgba(35,47,64,0.95); 
            z-index: 1000; 
            backdrop-filter: blur(20px); 
            align-items: center; 
            justify-content: center; 
            animation: fadeIn 0.4s; 
        }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .modal { 
            background: linear-gradient(145deg, var(--bg-primary), rgba(242,62,46,0.2)); 
            border: 5px solid var(--accent-gold); 
            border-radius: 40px; 
            max-width: 85vw; 
            max-height: 85vh; 
            padding: 4rem; 
            overflow-y: auto; 
            position: relative; 
            box-shadow: 0 80px 160px rgba(242,62,46,0.8);
            animation: modalSlide 0.6s cubic-bezier(0.34,1.56,0.64,1);
        }
        @keyframes modalSlide {
            from { transform: scale(0.5) translateY(100px); opacity: 0; }
            to { transform: scale(1) translateY(0); opacity: 1; }
        }
        .modal h2 { 
            color: var(--accent-gold); 
            margin-bottom: 2.5rem; 
            font-size: 3.2rem; 
            text-align: center; 
            text-shadow: 0 0 30px var(--accent-gold);
        }
        .modal-content { 
            line-height: 1.9; 
            font-size: 1.25rem; 
            text-align: justify;
        }
        .close-modal { 
            position: absolute; 
            top: 2rem; 
            right: 2.5rem; 
            background: linear-gradient(145deg, var(--accent-red1), var(--accent-red2)); 
            border: 3px solid var(--accent-gold); 
            font-size: 2.8rem; 
            color: var(--accent-gold); 
            cursor: pointer; 
            width: 60px; 
            height: 60px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            border-radius: 50%; 
            transition: all 0.4s;
            box-shadow: 0 10px 30px rgba(242,62,46,0.6);
        }
        .close-modal:hover { 
            background: var(--accent-gold); 
            color: var(--bg-primary); 
            transform: rotate(360deg) scale(1.15); 
        }
        
        /* Responsivo */
        @media (max-width: 768px) {
            .logo { font-size: 2rem; }
            .menu { flex-direction: column; gap: 1rem; }
            .historia-title { font-size: 3rem; }
            .historia-image { height: 300px; }
            .cards-grid { grid-template-columns: 1fr; gap: 2rem; }
            .modal { padding: 2.5rem 2rem; margin: 1rem; }
            .card-icon { font-size: 3.5rem; }
        }
        /* Carrossel Heróis Modal */
.carousel-container {
    position: relative;
    max-width: 700px;
    margin: 0 auto 2rem;
    background: rgba(35,47,64,0.3);
    border-radius: 25px;
    padding: 1.5rem;
    backdrop-filter: blur(20px);
    border: 3px solid var(--accent-gold);
    box-shadow: 0 30px 80px rgba(242,62,46,0.5);
}

.carousel {
    position: relative;
    width: 100%;
    height: 500px;
    overflow: hidden;
    border-radius: 20px;
}

.carousel-track {
    display: flex;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94);
}

.carousel-slide {
    min-width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateX(100%);
}

.carousel-slide.active {
    opacity: 1;
    transform: translateX(0);
}

.carousel-slide img {
    width: 280px;
    height: 380px;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: 0 25px 60px rgba(0,0,0,0.8);
    border: 4px solid var(--accent-gold);
    transition: all 0.5s;
}

.carousel-slide img:hover {
    transform: scale(1.05);
    box-shadow: 0 35px 80px rgba(242,170,82,0.6);
}

.hero-info {
    text-align: center;
    margin-top: 1.5rem;
    padding: 1.5rem;
    background: rgba(242,170,82,0.15);
    border-radius: 15px;
    backdrop-filter: blur(10px);
    border: 2px solid rgba(242,170,82,0.3);
}

.hero-info h3 {
    color: var(--accent-gold);
    font-size: 1.8rem;
    margin-bottom: 0.8rem;
    text-shadow: 0 0 15px var(--accent-gold);
}

.carousel-prev, .carousel-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: linear-gradient(145deg, var(--accent-red1), var(--accent-red2));
    border: none;
    color: var(--accent-gold);
    font-size: 2.5rem;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s;
    box-shadow: 0 15px 40px rgba(242,62,46,0.6);
}

.carousel-prev { left: 10px; }
.carousel-next { right: 10px; }

.carousel-prev:hover, .carousel-next:hover {
    background: var(--accent-gold);
    color: var(--bg-primary);
    transform: translateY(-50%) scale(1.15);
    box-shadow: 0 20px 50px rgba(242,170,82,0.7);
}

.carousel-dots {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 2rem;
}

.dot {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: rgba(242,170,82,0.4);
    cursor: pointer;
    transition: all 0.3s;
    border: 2px solid transparent;
}

.dot.active, .dot:hover {
    background: var(--accent-gold);
    transform: scale(1.3);
    box-shadow: 0 0 15px var(--accent-gold);
}

/* Responsivo Carrossel */
@media (max-width: 768px) {
    .carousel { height: 400px; }
    .carousel-slide img { width: 220px; height: 300px; }
    .carousel-prev, .carousel-next { width: 50px; height: 50px; font-size: 2rem; }
    .hero-info { padding: 1rem; }
}
    </style>
